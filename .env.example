# Copiar a .env.local y completar con los valores reales.
# .env.local NO se commitea (ver .gitignore). Ninguna credencial va en el repo.

# Proyecto de Supabase de PIYC — públicas, seguras para el cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service-role de Supabase — SOLO servidor. Nunca con prefijo NEXT_PUBLIC_,
# nunca en el cliente, nunca impresa en logs.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio en producción (para metadataBase, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=

# Sal del hash de IP del formulario de contacto (tope de envíos por hora).
# CÁRGALA SIEMPRE EN VERCEL. Si falta, el código cae a una constante escrita en
# este repositorio, y una sal pública no es una sal: quien la conozca puede
# recorrer las 4 mil millones de IPv4 y averiguar de qué conexión salió cada
# lead guardado en `site_mensajes`. Cualquier cadena larga y aleatoria sirve;
# cambiarla reinicia el conteo de todas las IP.
CONTACT_IP_SALT=

# ---------------------------------------------------------------------------
# AVISO POR CORREO DEL FORMULARIO DE CONTACTO (opcional)
# ---------------------------------------------------------------------------
# OPCIONAL DE VERDAD: si falta SMTP_HOST, SMTP_USER o SMTP_PASS, el formulario
# funciona igual que siempre (registra el lead y abre WhatsApp) y no manda
# correo ni muestra ningún error. Con las tres cargadas, además llega un aviso.
#
# Qué hay que conseguir para cada opción: docs/DESPLIEGUE.md, sección 4.
#
# Servidor SMTP. Ejemplos:
#   Google Workspace : smtp.gmail.com   puerto 587, SMTP_SECURE=false
#   Brevo            : smtp-relay.brevo.com  puerto 587, SMTP_SECURE=false
#   Resend           : smtp.resend.com   puerto 587, SMTP_SECURE=false
SMTP_HOST=
# 587 (STARTTLS, lo normal) o 465 (TLS directo). Por defecto 587.
SMTP_PORT=
# true solo con el puerto 465. Si se deja vacío se deduce del puerto.
SMTP_SECURE=
# Usuario del SMTP. En Workspace es el correo completo; en Resend es "resend";
# en Brevo es el login que da el panel.
SMTP_USER=
# Contraseña del SMTP. En Workspace es la CONTRASEÑA DE APLICACIÓN de 16
# caracteres, NO la contraseña normal de la cuenta.
SMTP_PASS=
# Remitente que verá PIYC. Tiene que ser una dirección del dominio que el
# servidor autentica; jamás el correo del visitante (lo marcaría como spam).
# Si se deja vacío se usa SMTP_USER. Admite "PIYC · Sitio web <correo@dominio>".
CONTACT_FROM=
# Destinatario del aviso. Si se deja vacío se usa el correo publicado en el
# panel (Ajustes → Contacto). NUNCA sale del formulario. Admite varias
# direcciones separadas por coma.
CONTACT_TO=

# NOTA: SUPABASE_ACCESS_TOKEN (token personal para la CLI / Management API de
# Supabase) es de uso local únicamente. No va aquí, no va en Vercel, no va en
# el repo — vence en días y es personal de quien lo genera.
