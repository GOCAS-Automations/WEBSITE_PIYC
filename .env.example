# Copiar a .env.local y completar con los valores reales.
# .env.local NO se commitea (ver .gitignore). Ninguna credencial va en el repo.

# Proyecto de Supabase de PIYC — públicas, seguras para el cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service-role de Supabase — SOLO servidor. Nunca con prefijo NEXT_PUBLIC_,
# nunca en el cliente, nunca impresa en logs.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio en producción (para metadataBase, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=

# NOTA: SUPABASE_ACCESS_TOKEN (token personal para la CLI / Management API de
# Supabase) es de uso local únicamente. No va aquí, no va en Vercel, no va en
# el repo — vence en días y es personal de quien lo genera.
